{
  "name": "xframe",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --config vite.preview.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && cd dist && zip -qr ../xframe-store-upload.zip . && cd .. && echo '→ xframe-store-upload.zip 已產生（manifest 在根目錄）'"
  },
  "dependencies": {
    "modern-screenshot": "^4.5.0",
    "preact": "^10.24.0",
    "simple-icons": "^16.27.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.0.278",
    "@types/node": "^26.1.2",
    "happy-dom": "^15.7.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
